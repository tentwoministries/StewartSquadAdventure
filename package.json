{
  "name": "stewart-squad-adventure",
  "version": "0.0.1",
  "private": true,
  "description": "Stewart Squad Adventure — Lights in the Dark. A low-poly 3D action RPG built for the Stewart kids.",
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:archive": "vite build --mode archive",
    "build:demo": "vite build --mode demo && node scripts/demo-root.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.4.1",
    "@types/three": "0.185.4",
    "eslint": "10.10.0",
    "puppeteer-core": "25.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "postprocessing": "6.39.4",
    "simplex-noise": "4.0.3",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14"
  }
}
